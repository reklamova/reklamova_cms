# Contract for variables injected by the local shell, hosting panel or secret manager.
# The CMS intentionally does not parse .env files in production.
REKLAMOVA_APP_URL=https://shop.example.com
REKLAMOVA_APP_DEBUG=false
REKLAMOVA_DATABASE_HOST=localhost
REKLAMOVA_DATABASE_PORT=3306
REKLAMOVA_DATABASE_DATABASE=reklamova
REKLAMOVA_DATABASE_USERNAME=reklamova
REKLAMOVA_DATABASE_PASSWORD=
REKLAMOVA_COMMERCE_STORE_CODE=default
REKLAMOVA_COMMERCE_CURRENCY=PLN
REKLAMOVA_COMMERCE_ING_PAY_ENVIRONMENT=sandbox
REKLAMOVA_COMMERCE_ING_PAY_MERCHANT_ID=
REKLAMOVA_COMMERCE_ING_PAY_SERVICE_ID=
REKLAMOVA_COMMERCE_ING_PAY_SERVICE_KEY=
REKLAMOVA_COMMERCE_ING_PAY_BEARER_TOKEN=
